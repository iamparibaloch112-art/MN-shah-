# Server Port (Google Cloud Run sets PORT=8080 automatically)
PORT=8080
NODE_ENV=production

# Authorized Owner Access (Only this Gmail account can access MN SHAH AI)
ALLOWED_OWNER_EMAIL=iamparibaloch112@gmail.com

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> Credentials -> Web application)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Server-Side Owner Password (set securely in Cloud Run / Secret Manager; NEVER put in frontend)
OWNER_PASSWORD=CHANGE_ME_SET_SECURE_SECRET

# Cryptographic HMAC Secret for persistent HttpOnly session cookies (32+ random chars)
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHAR_HEX_SECRET

# Gemini API Key (server-side only, never exposed to browser)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional Backup AI Provider (automatically disabled if blank or placeholder)
BACKUP_AI_API_KEY=
BACKUP_AI_BASE_URL=https://api.openai.com/v1/chat/completions
BACKUP_AI_MODEL=gpt-4o-mini
BACKUP_AI_DAILY_LIMIT=50
